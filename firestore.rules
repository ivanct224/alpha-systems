rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Es admin si su UID tiene un documento en /admins/{uid}
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Servicios: lectura pública, edición solo admin
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Estado del sistema y datos de contacto: lectura pública, edición solo admin
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Solicitudes de MISSION // SUPPORT:
    // cualquiera puede CREAR una solicitud, pero nadie (salvo el admin)
    // puede leer, editar o borrar solicitudes ajenas.
    match /requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(
                        ['name','contact','serviceType','description','status','createdAt']
                      )
                      && request.resource.data.status == 'pendiente'
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    // Documento admins/{uid}: nadie puede escribirlo desde el cliente.
    // Se crea manualmente desde la consola de Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
